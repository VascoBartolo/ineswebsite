# Rebuilt inside the image — don't ship or upload these in the build context
node_modules
dist

# VCS / meta
.git
.gitignore
*.md
Dockerfile
.dockerignore
.vercel

# macOS AppleDouble sidecars. Created whenever this repo is written to on an
# exFAT volume; the docker build context sender cannot read their xattrs and
# fails the whole build ("failed to xattr ._foo.py: operation not permitted").
._*
.DS_Store
